// Managed by linux-hardening (ansible role "hardening"). Local edits are overwritten.
// Restrict unattended-upgrades to security origins only. "#clear" drops the
// origins configured in 50unattended-upgrades before ours are added.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
{% if ansible_facts['distribution'] == 'Ubuntu' %}
        "origin=Ubuntu,archive=${distro_codename}-security,label=Ubuntu";
        "origin=UbuntuESMApps,archive=${distro_codename}-apps-security";
        "origin=UbuntuESM,archive=${distro_codename}-infra-security";
{% else %}
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
        "origin=Debian,codename=${distro_codename},label=Debian-Security";
{% endif %}
};
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if harden_auto_reboot | bool else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ harden_auto_reboot_time }}";
